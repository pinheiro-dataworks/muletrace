# Copy to .env and adjust. Never commit the real .env.

# Folder holding the raw AMLworld files (*_Trans.csv, *_accounts.csv, *_Patterns.txt).
# `make data` downloads them here when they are missing.
MULETRACE_RAW_DIR=data/raw

# Folder for Parquet outputs, feature snapshots and model artefacts.
MULETRACE_DATA_DIR=data
MULETRACE_ARTIFACTS_DIR=artifacts

# Kaggle credentials are read by the Kaggle CLI from ~/.kaggle; do not put them here.

# AWS: local runs use your named profile. CI uses GitHub OIDC and needs no keys.
AWS_PROFILE=muletrace-dev
AWS_REGION=us-east-1
